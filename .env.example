# Copie este arquivo para ".env" e preencha com valores próprios.
# O arquivo .env NÃO deve ser versionado (está no .gitignore).

# Senha do usuário SA do SQL Server (forte: maiúsculas, minúsculas, números e símbolo).
# Usada só pela inicialização do banco (serviço "db-init") — a API nunca se conecta
# como sa, e sim como o login dedicado "triar_app" (ver APP_DB_PASSWORD abaixo).
SA_PASSWORD=Troque-Esta-Senha-Forte@2026

# Senha do login dedicado da API no SQL Server (triar_app), criado automaticamente
# pelo serviço "db-init" com permissão restrita a TriarDb (leitura, escrita e DDL
# para as EF Migrations — nunca sysadmin). Forte e DIFERENTE de SA_PASSWORD.
APP_DB_PASSWORD=Troque-Esta-Outra-Senha-Forte@2026

# Chave de assinatura do JWT — mínimo 32 caracteres, aleatória e secreta.
# Gere uma nova, por exemplo: openssl rand -base64 48
JWT_KEY=troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres

# Chave de criptografia (AES-256-GCM) do nome do paciente em repouso — mínimo 32
# caracteres, aleatória e secreta, DIFERENTE da JWT_KEY.
# Gere uma nova, por exemplo: openssl rand -base64 48
DATA_PROTECTION_KEY=troque-por-outra-chave-aleatoria-de-no-minimo-32-caracteres
