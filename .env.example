# Copie este arquivo para ".env" e preencha com valores próprios.
# O arquivo .env NÃO deve ser versionado (está no .gitignore).

# Senha do usuário SA do SQL Server (forte: maiúsculas, minúsculas, números e símbolo).
SA_PASSWORD=

# Chave de assinatura do JWT — mínimo 32 caracteres, aleatória e secreta.
# Gere uma nova, por exemplo: openssl rand -base64 48
JWT_KEY=

# Chave de criptografia (AES-256-GCM) do nome do paciente em repouso — mínimo 32
# caracteres, aleatória e secreta, DIFERENTE da JWT_KEY.
# Gere uma nova, por exemplo: openssl rand -base64 48
DATA_PROTECTION_KEY=
