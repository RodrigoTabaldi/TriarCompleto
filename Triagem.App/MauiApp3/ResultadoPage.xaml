<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp3.ResultadoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F7F6"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16,20,16,28" Spacing="16"
                             MaximumWidthRequest="700"
                             HorizontalOptions="Fill">

            <Image Source="logo.png" HeightRequest="60" HorizontalOptions="Center" Margin="0,4,0,0"/>

            <Label Text="Resultado da triagem"
                   FontSize="23" FontAttributes="Bold"
                   TextColor="#0F172A" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

            <Label x:Name="TituloTriagem"
                   FontSize="15" TextColor="#6B7280" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>

            <!-- CARD DO RESULTADO -->
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="18" Shadow="0,6,24,#00000025">
                <VerticalStackLayout Spacing="16">

                    <!-- círculo com pontuação -->
                    <Border x:Name="CirculoPontuacao"
                            BackgroundColor="#10B981"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 100"
                            HeightRequest="130" WidthRequest="130"
                            HorizontalOptions="Center">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                            <Label x:Name="Pontuacao" Text="0" FontSize="40" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center"/>
                            <Label x:Name="PontuacaoMaxima" Text="de 0 pontos" FontSize="12"
                                   TextColor="White" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <Label x:Name="Classificacao" Text="—"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="#10B981" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>

                    <Label x:Name="Recomendacao"
                           FontSize="15" TextColor="#374151"
                           HorizontalTextAlignment="Center"/>

                    <BoxView HeightRequest="1" Color="#E5E7EB"/>

                    <!-- dados da pessoa avaliada -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="12">
                        <Label Grid.ColumnSpan="2" Text="Paciente" FontSize="12" TextColor="#6B7280"/>
                        <Label Grid.Row="1" Grid.ColumnSpan="2" x:Name="NomePaciente" FontAttributes="Bold" TextColor="#0F172A" LineBreakMode="WordWrap"/>

                        <Label Grid.Row="2" Text="Idade" FontSize="12" TextColor="#6B7280" Margin="0,8,0,0"/>
                        <Label Grid.Row="3" x:Name="IdadePaciente" FontAttributes="Bold" TextColor="#0F172A"/>

                        <Label Grid.Column="1" Grid.Row="2" Text="Data" FontSize="12" TextColor="#6B7280" Margin="0,8,0,0"/>
                        <Label Grid.Column="1" Grid.Row="3" x:Name="DataTriagem" FontAttributes="Bold" TextColor="#0F172A"/>
                    </Grid>

                    <VerticalStackLayout x:Name="DadosOpcionais" IsVisible="False" Spacing="8">
                        <Label x:Name="EscolaridadePaciente" TextColor="#374151" LineBreakMode="WordWrap" IsVisible="False"/>
                        <Label x:Name="DoencasPreviasPaciente" TextColor="#374151" LineBreakMode="WordWrap" IsVisible="False"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="DetalhesRespostas" IsVisible="False" Spacing="10">
                <Label Text="Informações complementares" FontSize="19" FontAttributes="Bold" TextColor="#0F172A" />
                <VerticalStackLayout x:Name="ListaRespostas" Spacing="8" />
            </VerticalStackLayout>

            <Label Text="⚠️ Este resultado é uma orientação inicial e não substitui uma avaliação profissional."
                   FontSize="12" TextColor="#6B7280" HorizontalTextAlignment="Center"/>

            <!-- AÇÕES -->
            <Button Text="🔁 Aplicar esta triagem em outra pessoa"
                    Clicked="RepetirTriagem"
                    BackgroundColor="#10B981"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12" HeightRequest="52" FontSize="15" Padding="12,0"/>

            <Button Text="Voltar para a home"
                    Clicked="VoltarHome"
                    BackgroundColor="Transparent"
                    TextColor="#374151"
                    CornerRadius="12" HeightRequest="48" FontSize="15"/>

            <BoxView HeightRequest="20" Color="Transparent"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
