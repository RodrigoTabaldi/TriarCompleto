<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp3.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">
    <Grid Padding="44">
        <VerticalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="18">
            <Image
                x:Name="Logo"
                Source="logo.png"
                WidthRequest="220"
                HeightRequest="120"
                Aspect="AspectFit"
                Opacity="0"
                Scale="0.82"/>
            <BoxView
                x:Name="Indicador"
                WidthRequest="42"
                HeightRequest="3"
                CornerRadius="2"
                Color="#10B981"
                Opacity="0"
                ScaleX="0.2"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
