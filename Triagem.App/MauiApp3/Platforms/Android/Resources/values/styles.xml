<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        O tema padrão do .NET MAUI (Maui.MainTheme.Base) herda de
        Theme.MaterialComponents.DayNight, que usa colorPrimaryVariant (#3700B3,
        o roxo do Material Design) como cor da barra de status. O MAUI só troca
        colorPrimary/colorPrimaryDark/colorAccent, por isso a faixa roxa continuava
        aparecendo no topo do app. Aqui o tema é sobrescrito com a identidade Triar:
        recursos do app têm precedência sobre os da biblioteca.
    -->
    <style name="Triar.MainTheme.Base" parent="Maui.MainTheme">
        <!-- itens originais de Maui.MainTheme.NoActionBar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:actionModeBackground">?attr/colorPrimary</item>
        <item name="android:actionModeStyle">@style/ActionMode</item>

        <!-- identidade Triar no lugar das cores Material -->
        <item name="colorPrimaryVariant">@color/colorSurface</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>

        <!-- barras do sistema claras, no tom das telas do app -->
        <item name="android:statusBarColor">@color/colorSurface</item>
        <item name="android:navigationBarColor">@color/colorSurface</item>
        <item name="android:windowBackground">@color/colorPageBackground</item>
    </style>

    <style name="Maui.MainTheme.NoActionBar" parent="Triar.MainTheme.Base" />
</resources>
