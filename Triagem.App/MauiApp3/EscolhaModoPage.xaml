<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp3.EscolhaModoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F7F6"
    Shell.NavBarIsVisible="False">

    <Grid Padding="12">
        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            MaximumWidthRequest="620"
            Spacing="10">

            <Border
                BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Padding="16"
                HorizontalOptions="Fill"
                Shadow="0,4,20,#00000020">

                <VerticalStackLayout Spacing="10">
                    <Image Source="logo.png" HeightRequest="58" HorizontalOptions="Center"/>

                    <Label
                        Text="Como você quer fazer a triagem?"
                        FontSize="22"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        TextColor="#0F172A"/>

                    <Label
                        Text="Escolha o tipo de atendimento para continuar"
                        FontSize="13"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        TextColor="#6B7280"/>

                    <VerticalStackLayout Spacing="8" Margin="0,4,0,0">

                        <Border
                            x:Name="CardIndividual"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16"
                            Padding="12"
                            HorizontalOptions="Fill">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="SelecionarIndividual"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="5">
                                <Image Source="icone_individual.png"
                                       WidthRequest="34"
                                       HeightRequest="34"
                                       HorizontalOptions="Start"/>

                                <Label Text="Triagem Individual" FontSize="17" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label Text="Resultado imediato, com dados salvos neste aparelho." FontSize="12" TextColor="#6B7280"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            x:Name="CardGrupo"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16"
                            Padding="12"
                            HorizontalOptions="Fill">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="SelecionarGrupo"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="5">
                                <Image Source="icone_grupo.png"
                                       WidthRequest="34"
                                       HeightRequest="34"
                                       HorizontalOptions="Start"/>

                                <Label Text="Triagem em Grupo" FontSize="17" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label Text="Atenda várias pessoas e acompanhe o histórico." FontSize="12" TextColor="#6B7280"/>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <Button
                        x:Name="BotaoContinuar"
                        Text="Continuar"
                        Clicked="Continuar"
                        IsEnabled="False"
                        BackgroundColor="#10B981"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="48"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
