<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp3.EscolhaModoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F7F6"
    Shell.NavBarIsVisible="False">

    <ScrollView>
    <Grid Padding="16" MinimumHeightRequest="600">
        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            MaximumWidthRequest="668"
            Spacing="10">

            <Border
                x:Name="ModePanel"
                BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Padding="20"
                HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="10">
                    <Image Source="logo.png" HeightRequest="58" HorizontalOptions="Center"/>

                    <Label
                        Text="Como você quer fazer a triagem?"
                        FontSize="22"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        TextColor="#0F172A"/>

                    <Label
                        Text="Escolha o tipo de atendimento para continuar"
                        FontSize="13"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        TextColor="#6B7280"/>

                    <Grid x:Name="ModeOptions" ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="8" Margin="0,8,0,8">

                        <Border
                            x:Name="CardIndividual"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16"
                            Padding="16"
                            Grid.Column="0"
                            MinimumHeightRequest="216"
                            HorizontalOptions="Fill">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="SelecionarIndividual"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="7">
                                <Image Source="icone_individual.png"
                                       WidthRequest="44"
                                       HeightRequest="44"
                                       HorizontalOptions="Start"/>

                                <Label Text="Triagem Individual" FontSize="17" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label Text="Resultado exibido na hora, ideal para um atendimento rápido." FontSize="13" TextColor="#6B7280"/>
                                <Border BackgroundColor="#F3F4F6" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="8,3" HorizontalOptions="Start">
                                    <HorizontalStackLayout Spacing="5">
                                        <Image Source="icone_privado.png" WidthRequest="14" HeightRequest="14"/>
                                        <Label Text="Não salva dados na nuvem" FontSize="11" TextColor="#374151"/>
                                    </HorizontalStackLayout>
                                </Border>
                                <Label Text="Selecionar →" FontSize="14" FontAttributes="Bold" TextColor="#10B981" Margin="0,6,0,0"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            x:Name="CardGrupo"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16"
                            Padding="16"
                            Grid.Column="1"
                            MinimumHeightRequest="216"
                            HorizontalOptions="Fill">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="SelecionarGrupo"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="7">
                                <Image Source="icone_grupo.png"
                                       WidthRequest="44"
                                       HeightRequest="44"
                                       HorizontalOptions="Start"/>

                                <Label Text="Triagem em Grupo" FontSize="17" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label Text="Faça a triagem de várias pessoas e acompanhe o histórico de cada uma." FontSize="13" TextColor="#6B7280"/>
                                <Border BackgroundColor="#F3F4F6" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="8,3" HorizontalOptions="Start">
                                    <HorizontalStackLayout Spacing="5">
                                        <Image Source="icone_salvar.png" WidthRequest="14" HeightRequest="14"/>
                                        <Label Text="Salva dados" FontSize="11" TextColor="#374151"/>
                                    </HorizontalStackLayout>
                                </Border>
                                <Label Text="Selecionar →" FontSize="14" FontAttributes="Bold" TextColor="#10B981" Margin="0,6,0,0"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Button
                        x:Name="BotaoContinuar"
                        Text="Continuar"
                        Clicked="Continuar"
                        IsEnabled="False"
                        BackgroundColor="#10B981"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="48"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
    </ScrollView>
</ContentPage>
