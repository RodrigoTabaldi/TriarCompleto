<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp3.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MauiApp3.Models"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#009B72"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="BorderColor" Value="#009B72"/>
            <Setter Property="BorderWidth" Value="1"/>
            <Setter Property="TextColor" Value="#009B72"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </ContentPage.Resources>

    <Grid>

        <!-- ================= DESKTOP ================= -->
        <Grid x:Name="DesktopRoot"
              IsVisible="False"
              BackgroundColor="#FBFCFD"
              ColumnDefinitions="246,*">

            <Border BackgroundColor="White"
                    Stroke="#E5EAF0"
                    StrokeThickness="0,0,1,0"
                    Padding="28,44,18,28">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Image Source="logo.png"
                           HeightRequest="92"
                           HorizontalOptions="Start"/>

                    <ScrollView Grid.Row="1" Margin="0,48,0,0">
                    <VerticalStackLayout Spacing="13">
                        <Border BackgroundColor="#ECF8F4" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="2,12">
                            <HorizontalStackLayout Spacing="14">
                                <Image Source="nav_home.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                                <Label Text="Início" FontSize="16" FontAttributes="Bold" TextColor="#009B72" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <HorizontalStackLayout Spacing="14" Padding="2,10">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IrHistoricoGeral"/>
                            </HorizontalStackLayout.GestureRecognizers>
                            <Image Source="nav_history.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                            <Label Text="Histórico geral" FontSize="16" TextColor="#40506A"/>
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1" Color="#E4EAF0" Margin="0,16"/>

                        <HorizontalStackLayout Spacing="14" Padding="2,10">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IrCreditos"/>
                            </HorizontalStackLayout.GestureRecognizers>
                            <Image Source="nav_credits.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                            <Label Text="Créditos" FontSize="16" TextColor="#40506A"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="14" Padding="2,10">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IrContato"/>
                            </HorizontalStackLayout.GestureRecognizers>
                            <Image Source="nav_contact.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                            <Label Text="Contato" FontSize="16" TextColor="#40506A"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="14" Padding="2,10">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IrSobre"/>
                            </HorizontalStackLayout.GestureRecognizers>
                            <Image Source="nav_about.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                            <Label Text="Sobre o projeto" FontSize="16" TextColor="#40506A"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="14" Padding="2,10">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IrCriarTriagem"/>
                            </HorizontalStackLayout.GestureRecognizers>
                            <Image Source="nav_create.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                            <Label Text="Criar sua triagem" FontSize="16" FontAttributes="Bold" TextColor="#009B72"/>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                    </ScrollView>

                    <HorizontalStackLayout Grid.Row="2" Spacing="14" Padding="2,10">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Sair"/>
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image Source="nav_logout.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                        <Label x:Name="BotaoSairDesktop" Text="Sair" FontSize="16" TextColor="#40506A"/>
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <CollectionView x:Name="ListaTriagensDesktop"
                            Grid.Column="1"
                            Margin="38,26,38,18"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Nenhuma triagem disponível nesta categoria." TextColor="#465674" Margin="0,20"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="LayoutGrade"
                                     Orientation="Vertical"
                                     Span="3"
                                     HorizontalItemSpacing="26"
                                     VerticalItemSpacing="14"/>
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <Grid RowDefinitions="Auto,Auto" Margin="0,0,0,18">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border BackgroundColor="#009B72"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 100"
                                    HeightRequest="56"
                                    WidthRequest="56">
                                <Label x:Name="InicialUsuarioDesktop"
                                       Text="JS"
                                       TextColor="White"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label x:Name="NomeUsuario" Text="João Silva" FontSize="18" FontAttributes="Bold" TextColor="#07142E"/>
                                <Label x:Name="EmailUsuario" Text="joaosilva@email.com" FontSize="14" TextColor="#465674"/>
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="10">
                                <Button Text="✎  Editar triagens"
                                        Clicked="AlternarEdicaoHome"
                                        BackgroundColor="White"
                                        BorderColor="#009B72"
                                        BorderWidth="1"
                                        TextColor="#009B72"
                                        CornerRadius="8"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        HeightRequest="48"
                                        Padding="18,0"/>
                                <Button Text="↻  Atualizar"
                                        Clicked="Atualizar"
                                        BackgroundColor="White"
                                        BorderColor="#DDE5EE"
                                        BorderWidth="1"
                                        TextColor="#07142E"
                                        CornerRadius="8"
                                        FontSize="15"
                                        HeightRequest="48"
                                        Padding="18,0"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <VerticalStackLayout Grid.Row="1" Spacing="6" Margin="0,34,0,0">
                            <Label Text="Triagens" FontSize="30" FontAttributes="Bold" TextColor="#07142E"/>
                            <Label Text="Selecione uma triagem para iniciar o atendimento" FontSize="16" TextColor="#465674"/>
                            <HorizontalStackLayout Spacing="10" Margin="0,18,0,0">
                                <Button x:Name="BotaoPrincipaisDesktop" Text="Triagens principais" Clicked="MostrarTriagensPrincipais"
                                        BackgroundColor="#009B72" TextColor="White" CornerRadius="10"/>
                                <Button x:Name="BotaoEspecificasDesktop" Text="Triagens específicas" Clicked="MostrarTriagensEspecificas"
                                        BackgroundColor="White" TextColor="#009B72" BorderColor="#009B72" BorderWidth="1" CornerRadius="10"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TriagemResumo">
                        <Border BackgroundColor="White"
                                Stroke="#EDF0F3"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="18,14,18,16"
                                Shadow="0,2,12,#00000012">
                            <VerticalStackLayout Spacing="9">
                                <Image Source="{Binding ImagemHome}" HeightRequest="148" Aspect="AspectFit"/>
                                <Label Text="{Binding Titulo}" FontSize="18" FontAttributes="Bold" TextColor="#07142E" LineBreakMode="WordWrap"/>
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="Público alvo:" FontSize="14" TextColor="#40506A"/>
                                    <Label Text="{Binding PublicoAlvo}" FontSize="14" TextColor="#40506A"/>
                                </VerticalStackLayout>
                                <Button Text="Entrar" Clicked="AbrirTriagem" Style="{StaticResource PrimaryButton}"/>
                                <Button Text="Ver histórico de pacientes" Clicked="AbrirHistorico" Style="{StaticResource OutlineButton}"/>

                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding ModoEdicao}">
                                    <Label Text="Exibir na home" VerticalOptions="Center" TextColor="#374151"/>
                                    <Switch Grid.Column="1" IsToggled="{Binding VisivelNaHome, Mode=TwoWay}" OnColor="#009B72"/>
                                    <Button Grid.Column="2" Text="✎" Clicked="EditarTriagem" BackgroundColor="#E6F6F1" CornerRadius="8" WidthRequest="40" HeightRequest="40" IsVisible="{Binding MinhaAutoria}" SemanticProperties.Description="Editar triagem e sua imagem"/>
                                    <Button Grid.Column="3" Text="🗑" Clicked="ExcluirTriagem" BackgroundColor="#FEE2E2" TextColor="#EF4444" CornerRadius="8" WidthRequest="40" HeightRequest="40" IsVisible="{Binding MinhaAutoria}" SemanticProperties.Description="Excluir triagem"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout Spacing="20" Padding="0,18,0,0">
                        <Button x:Name="BotaoSalvarHomeDesktop"
                                Text="Salvar configuração da home"
                                Clicked="SalvarConfiguracaoHome"
                                IsVisible="False"
                                Style="{StaticResource PrimaryButton}"/>

                        <Border BackgroundColor="White"
                                Stroke="#EDF0F3"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="22,18"
                                Shadow="0,2,12,#00000012">
                            <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start">
                                <HorizontalStackLayout Spacing="10" WidthRequest="250" Margin="0,6">
                                    <Label Text="♁" FontSize="24" TextColor="#009B72"/>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Segurança" FontSize="13" FontAttributes="Bold" TextColor="#009B72"/>
                                        <Label Text="Seus dados e dos pacientes estão protegidos." FontSize="11" TextColor="#40506A"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10" WidthRequest="250" Margin="0,6">
                                    <Label Text="▣" FontSize="24" TextColor="#009B72"/>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Privacidade" FontSize="13" FontAttributes="Bold" TextColor="#009B72"/>
                                        <Label Text="Cumprimos a LGPD e boas práticas de segurança." FontSize="11" TextColor="#40506A"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10" WidthRequest="250" Margin="0,6">
                                    <Label Text="♚" FontSize="24" TextColor="#009B72"/>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Uso Acadêmico" FontSize="13" FontAttributes="Bold" TextColor="#009B72"/>
                                        <Label Text="Projeto para fins acadêmicos e aprendizado." FontSize="11" TextColor="#40506A"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10" WidthRequest="250" Margin="0,6">
                                    <Label Text="☼" FontSize="24" TextColor="#009B72"/>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Melhoria Contínua" FontSize="13" FontAttributes="Bold" TextColor="#009B72"/>
                                        <Label Text="Sua participação ajuda a melhorar o sistema." FontSize="11" TextColor="#40506A"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </FlexLayout>
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </Grid>

        <!-- ================= MOBILE ================= -->
        <Grid x:Name="MobileRoot"
              BackgroundColor="White"
              RowDefinitions="*,78">

            <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,16,20,28" Spacing="18">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Image Source="logo.png"
                                   HeightRequest="52"
                                   HorizontalOptions="Start"/>
                            <Border Grid.Column="1"
                                    BackgroundColor="#009B72"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 100"
                                    HeightRequest="44"
                                    WidthRequest="44"
                                     VerticalOptions="Center"
                                     SemanticProperties.Description="Conta: sair ou trocar modo">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Sair"/>
                                </Border.GestureRecognizers>
                                <Label x:Name="InicialUsuarioMobile"
                                       Text="JS"
                                       TextColor="White"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <Label x:Name="SaudacaoUsuarioMobile" Text="Olá" FontSize="23" FontAttributes="Bold" TextColor="#07142E" Margin="0,24,0,0" LineBreakMode="WordWrap"/>
                        <Label Text="Como você está hoje?" FontSize="15" TextColor="#465674" Margin="0,3,0,0"/>

                        <Label Text="Triagens disponíveis" FontSize="22" FontAttributes="Bold" TextColor="#07142E" Margin="0,28,0,0"/>
                        <Label Text="Escolha uma triagem para iniciar" FontSize="14" TextColor="#465674" Margin="0,2,0,0"/>
                        <Border BackgroundColor="#F0F3F8" Stroke="#E1E6EF" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="4" Margin="0,14,0,0">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                <Button x:Name="BotaoPrincipaisMobile" Text="Triagens principais" Clicked="MostrarTriagensPrincipais"
                                        BackgroundColor="#009B72" TextColor="White" CornerRadius="9" FontSize="12" HeightRequest="40" Padding="4,0"/>
                                <Button Grid.Column="1" x:Name="BotaoEspecificasMobile" Text="Triagens específicas" Clicked="MostrarTriagensEspecificas"
                                        BackgroundColor="Transparent" TextColor="#40506A" BorderWidth="0" CornerRadius="9" FontSize="12" HeightRequest="40" Padding="4,0"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                <VerticalStackLayout x:Name="ListaTriagensMobile" Spacing="12">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:TriagemResumo">
                        <Border BackgroundColor="White"
                                Stroke="#EDF0F3"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                 Padding="12"
                                Shadow="0,3,12,#00000012">
                            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                <Image Source="{Binding ImagemHome}" WidthRequest="100" HeightRequest="100" Aspect="AspectFit" VerticalOptions="Center" Grid.RowSpan="2"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Titulo}" FontSize="16" FontAttributes="Bold" TextColor="#07142E" LineBreakMode="WordWrap"/>
                                    <Label Text="Público alvo:" FontSize="12" TextColor="#40506A" Margin="0,4,0,0"/>
                                    <Label Text="{Binding PublicoAlvo}" FontSize="12" TextColor="#40506A" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Text="Entrar" Clicked="AbrirTriagem" Style="{StaticResource PrimaryButton}" HeightRequest="40" FontSize="12" Padding="2,0"/>
                                    <Button Grid.Column="1" Text="Ver histórico" Clicked="AbrirHistorico" Style="{StaticResource OutlineButton}" HeightRequest="40" FontSize="11" Padding="2,0"/>
                                </Grid>
                                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding ModoEdicao}">
                                        <Label Text="Exibir na home" VerticalOptions="Center" TextColor="#374151"/>
                                        <Switch Grid.Column="1" IsToggled="{Binding VisivelNaHome, Mode=TwoWay}" OnColor="#009B72"/>
                                        <Button Grid.Column="2" Text="✎" Clicked="EditarTriagem" BackgroundColor="#E6F6F1" CornerRadius="8" WidthRequest="40" HeightRequest="40" IsVisible="{Binding MinhaAutoria}" SemanticProperties.Description="Editar triagem e sua imagem"/>
                                        <Button Grid.Column="3" Text="🗑" Clicked="ExcluirTriagem" BackgroundColor="#FEE2E2" TextColor="#EF4444" CornerRadius="8" WidthRequest="40" HeightRequest="40" IsVisible="{Binding MinhaAutoria}" SemanticProperties.Description="Excluir triagem"/>
                                    </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label x:Name="MensagemMobileVazia" Text="Nenhuma triagem disponível nesta categoria."
                       IsVisible="False" TextColor="#465674" Margin="0,16"/>
                <Button x:Name="BotaoSalvarHomeMobile" Text="Salvar configuração da home"
                        Clicked="SalvarConfiguracaoHome" IsVisible="False"
                        Style="{StaticResource PrimaryButton}"/>

            </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="1" BackgroundColor="White" RowDefinitions="1,*" HeightRequest="78" VerticalOptions="End">
                <BoxView Color="#EEF1F4" HeightRequest="1"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" Padding="8,13,8,12">
                    <Grid RowDefinitions="24,Auto" RowSpacing="2" HorizontalOptions="Fill" VerticalOptions="Start">
                        <Image Source="nav_home.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center"/>
                        <Label Grid.Row="1" Text="Início" FontSize="10" TextColor="#009B72" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Column="1" RowDefinitions="24,Auto" RowSpacing="2" HorizontalOptions="Fill" VerticalOptions="Start">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="IrCreditos"/></Grid.GestureRecognizers>
                        <Image Source="nav_credits.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center"/>
                        <Label Grid.Row="1" Text="Créditos" FontSize="10" TextColor="#40506A" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Column="2" RowDefinitions="24,Auto" RowSpacing="2" HorizontalOptions="Fill" VerticalOptions="Start">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="IrContato"/></Grid.GestureRecognizers>
                        <Image Source="nav_contact.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center"/>
                        <Label Grid.Row="1" Text="Contato" FontSize="10" TextColor="#40506A" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Column="3" RowDefinitions="24,Auto" RowSpacing="2" HorizontalOptions="Fill" VerticalOptions="Start">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="IrSobre"/></Grid.GestureRecognizers>
                        <Image Source="nav_about.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center"/>
                        <Label Grid.Row="1" Text="Sobre o projeto" FontSize="8" TextColor="#40506A" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="NoWrap"/>
                    </Grid>
                    <Grid Grid.Column="4" RowDefinitions="24,Auto" RowSpacing="2" HorizontalOptions="Fill" VerticalOptions="Start">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="IrCriarTriagem"/></Grid.GestureRecognizers>
                        <Image Source="nav_create.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center"/>
                        <Label Grid.Row="1" Text="Criar triagem" FontSize="8" TextColor="#40506A" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="NoWrap"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
