<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp3.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MauiApp3.Models"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#009B72"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="BorderColor" Value="#009B72"/>
            <Setter Property="BorderWidth" Value="1"/>
            <Setter Property="TextColor" Value="#009B72"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="SidebarItem" TargetType="Border">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 9"/>
            <Setter Property="Padding" Value="12,11"/>
        </Style>

        <Style x:Key="SidebarLabel" TargetType="Label">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextColor" Value="#40506A"/>
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="LineBreakMode" Value="WordWrap"/>
        </Style>

        <Style x:Key="SidebarIcon" TargetType="Image">
            <Setter Property="WidthRequest" Value="22"/>
            <Setter Property="HeightRequest" Value="22"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>

        <ControlTemplate x:Key="DesktopTriagemCard" x:DataType="models:TriagemResumo">
            <Border BackgroundColor="White"
                    Stroke="#EDF0F3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="18,14,18,16"
                    Shadow="0,2,12,#00000012">
                <VerticalStackLayout Spacing="9">
                    <Border HeightRequest="132"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="#F4F8FC">
                        <Image Source="{Binding ImagemHome}"
                               Aspect="AspectFit"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"/>
                    </Border>
                    <Label Text="{Binding Titulo}" FontSize="18" FontAttributes="Bold" TextColor="#07142E" LineBreakMode="WordWrap" MinimumHeightRequest="48"/>
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Público alvo:" FontSize="14" TextColor="#40506A"/>
                        <Label Text="{Binding PublicoAlvo}" FontSize="14" TextColor="#40506A" MinimumHeightRequest="38"/>
                    </VerticalStackLayout>
                    <Button Text="Entrar" Clicked="AbrirTriagem" Style="{StaticResource PrimaryButton}"/>
                    <Button Text="Ver histórico de pacientes" Clicked="AbrirHistorico" Style="{StaticResource OutlineButton}"/>

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding ModoEdicao}">
                        <Label Text="Exibir na home" VerticalOptions="Center" TextColor="#374151"/>
                        <Switch Grid.Column="1" IsToggled="{Binding VisivelNaHome, Mode=TwoWay}" OnColor="#009B72"/>
                        <Button Grid.Column="2" Text="✎" Clicked="EditarTriagem" BackgroundColor="#E6F6F1" CornerRadius="8" WidthRequest="40" HeightRequest="40" IsVisible="{Binding MinhaAutoria}" SemanticProperties.Description="Editar triagem e sua imagem"/>
                        <Button Grid.Column="3" Text="🗑" Clicked="ExcluirTriagem" BackgroundColor="#FEE2E2" TextColor="#EF4444" CornerRadius="8" WidthRequest="40" HeightRequest="40" IsVisible="{Binding MinhaAutoria}" SemanticProperties.Description="Excluir triagem"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </ControlTemplate>
    </ContentPage.Resources>

    <Grid>

        <!-- ================= DESKTOP ================= -->
        <Grid x:Name="DesktopRoot"
              IsVisible="False"
              BackgroundColor="#FBFCFD"
              ColumnDefinitions="286,*">

            <Border BackgroundColor="White"
                    Stroke="#E5EAF0"
                    StrokeThickness="0,0,1,0"
                    Padding="22,34,22,24">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Image Source="logo.png"
                           HeightRequest="86"
                           HorizontalOptions="Center"/>

                    <VerticalStackLayout Grid.Row="1" Spacing="5" Margin="0,38,0,0">
                        <Border Style="{StaticResource SidebarItem}" BackgroundColor="#ECF8F4">
                            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                <Image Source="nav_home.png" Style="{StaticResource SidebarIcon}"/>
                                <Label Grid.Column="1" Text="Início" Style="{StaticResource SidebarLabel}" FontAttributes="Bold" TextColor="#009B72"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SidebarItem}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IrHistoricoGeral"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                <Image Source="nav_history.png" Style="{StaticResource SidebarIcon}"/>
                                <Label Grid.Column="1" Text="Histórico geral" Style="{StaticResource SidebarLabel}"/>
                            </Grid>
                        </Border>

                        <BoxView HeightRequest="1" Color="#E4EAF0" Margin="12,13"/>

                        <Border Style="{StaticResource SidebarItem}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IrCreditos"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                <Image Source="nav_credits.png" Style="{StaticResource SidebarIcon}"/>
                                <Label Grid.Column="1" Text="Créditos" Style="{StaticResource SidebarLabel}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SidebarItem}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IrContato"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                <Image Source="nav_contact.png" Style="{StaticResource SidebarIcon}"/>
                                <Label Grid.Column="1" Text="Contato" Style="{StaticResource SidebarLabel}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SidebarItem}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IrSobre"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                <Image Source="nav_about.png" Style="{StaticResource SidebarIcon}"/>
                                <Label Grid.Column="1" Text="Sobre o projeto" Style="{StaticResource SidebarLabel}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SidebarItem}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IrCriarTriagem"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                <Image Source="nav_create.png" Style="{StaticResource SidebarIcon}"/>
                                <Label Grid.Column="1" Text="Criar sua triagem" Style="{StaticResource SidebarLabel}" FontAttributes="Bold" TextColor="#009B72"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Border Grid.Row="2" Style="{StaticResource SidebarItem}" BackgroundColor="#F8FAFC">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Sair"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                            <Image Source="nav_logout.png" Style="{StaticResource SidebarIcon}"/>
                            <Label x:Name="BotaoSairDesktop" Grid.Column="1" Text="Sair" Style="{StaticResource SidebarLabel}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <CollectionView x:Name="ListaTriagensDesktop"
                            Grid.Column="1"
                            Margin="38,26,38,18"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="14"/>
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <Grid RowDefinitions="Auto,Auto" Margin="0,0,110,18">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border BackgroundColor="#009B72"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 100"
                                    HeightRequest="56"
                                    WidthRequest="56">
                                <Label x:Name="InicialUsuarioDesktop"
                                       Text="JS"
                                       TextColor="White"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label x:Name="NomeUsuario" Text="João Silva" FontSize="18" FontAttributes="Bold" TextColor="#07142E"/>
                                <Label x:Name="EmailUsuario" Text="joaosilva@email.com" FontSize="14" TextColor="#465674"/>
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="10">
                                <Button Text="✎  Editar triagens"
                                        Clicked="AlternarEdicaoHome"
                                        BackgroundColor="White"
                                        BorderColor="#009B72"
                                        BorderWidth="1"
                                        TextColor="#009B72"
                                        CornerRadius="8"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        HeightRequest="48"
                                        Padding="18,0"/>
                                <Button Text="↻  Atualizar"
                                        Clicked="Atualizar"
                                        BackgroundColor="White"
                                        BorderColor="#DDE5EE"
                                        BorderWidth="1"
                                        TextColor="#07142E"
                                        CornerRadius="8"
                                        FontSize="15"
                                        HeightRequest="48"
                                        Padding="18,0"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <VerticalStackLayout Grid.Row="1" Spacing="6" Margin="0,34,0,0">
                            <Label Text="Triagens disponíveis" FontSize="30" FontAttributes="Bold" TextColor="#07142E"/>
                            <Label Text="Selecione uma triagem para iniciar o atendimento" FontSize="16" TextColor="#465674"/>
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LinhaTriagens">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="26">
                            <ContentView BindingContext="{Binding Primeira}"
                                         ControlTemplate="{StaticResource DesktopTriagemCard}"/>
                            <Grid Grid.Column="1" IsVisible="{Binding TemSegunda}">
                                <ContentView BindingContext="{Binding Segunda}"
                                             ControlTemplate="{StaticResource DesktopTriagemCard}"/>
                            </Grid>
                            <Grid Grid.Column="2" IsVisible="{Binding TemTerceira}">
                                <ContentView BindingContext="{Binding Terceira}"
                                             ControlTemplate="{StaticResource DesktopTriagemCard}"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout Spacing="20" Padding="0,18,0,0">
                        <Button x:Name="BotaoSalvarHomeDesktop"
                                Text="Salvar configuração da home"
                                Clicked="SalvarConfiguracaoHome"
                                IsVisible="False"
                                Style="{StaticResource PrimaryButton}"/>

                        <Border BackgroundColor="White"
                                Stroke="#EDF0F3"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="22,18"
                                Shadow="0,2,12,#00000012">
                            <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start">
                                <HorizontalStackLayout Spacing="10" WidthRequest="250" Margin="0,6">
                                    <Label Text="♁" FontSize="24" TextColor="#009B72"/>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Segurança" FontSize="13" FontAttributes="Bold" TextColor="#009B72"/>
                                        <Label Text="Seus dados e dos pacientes estão protegidos." FontSize="11" TextColor="#40506A"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10" WidthRequest="250" Margin="0,6">
                                    <Label Text="▣" FontSize="24" TextColor="#009B72"/>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Privacidade" FontSize="13" FontAttributes="Bold" TextColor="#009B72"/>
                                        <Label Text="Cumprimos a LGPD e boas práticas de segurança." FontSize="11" TextColor="#40506A"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10" WidthRequest="250" Margin="0,6">
                                    <Label Text="♚" FontSize="24" TextColor="#009B72"/>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Uso Acadêmico" FontSize="13" FontAttributes="Bold" TextColor="#009B72"/>
                                        <Label Text="Projeto para fins acadêmicos e aprendizado." FontSize="11" TextColor="#40506A"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10" WidthRequest="250" Margin="0,6">
                                    <Label Text="☼" FontSize="24" TextColor="#009B72"/>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Melhoria Contínua" FontSize="13" FontAttributes="Bold" TextColor="#009B72"/>
                                        <Label Text="Sua participação ajuda a melhorar o sistema." FontSize="11" TextColor="#40506A"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </FlexLayout>
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </Grid>

        <!-- ================= MOBILE ================= -->
        <Grid x:Name="MobileRoot"
              BackgroundColor="White"
              RowDefinitions="*,Auto">

            <CollectionView x:Name="ListaTriagensMobile"
                            SelectionMode="None"
                            Margin="18,0"
                            ItemSizingStrategy="MeasureFirstItem"
                            VerticalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="16"/>
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <VerticalStackLayout Spacing="0" Padding="0,20,0,14">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <Image Source="logo.png"
                                   HeightRequest="64"
                                   HorizontalOptions="Start"/>
                            <Border Grid.Column="1"
                                    BackgroundColor="#009B72"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 100"
                                    HeightRequest="44"
                                    WidthRequest="44"
                                    VerticalOptions="Center">
                                <Label x:Name="InicialUsuarioMobile"
                                       Text="JS"
                                       TextColor="White"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <Label x:Name="SaudacaoUsuarioMobile" Text="Olá, João Silva" FontSize="20" FontAttributes="Bold" TextColor="#07142E" Margin="0,16,0,0"/>
                        <Label Text="Como você está hoje?" FontSize="14" TextColor="#465674" Margin="0,3,0,0"/>

                        <Label Text="Triagens disponíveis" FontSize="22" FontAttributes="Bold" TextColor="#07142E" Margin="0,24,0,0"/>
                        <Label Text="Escolha uma triagem para iniciar" FontSize="15" TextColor="#465674" Margin="0,3,0,0"/>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TriagemResumo">
                        <Border BackgroundColor="White"
                                Stroke="#EDF0F3"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,12">
                            <Grid ColumnDefinitions="112,*" ColumnSpacing="12">
                                <Border HeightRequest="96"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="#F4F8FC"
                                        VerticalOptions="Center">
                                    <Image Source="{Binding ImagemHome}"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                    <Label Text="{Binding Titulo}" FontSize="16" FontAttributes="Bold" TextColor="#05070D"
                                           LineBreakMode="WordWrap" MaxLines="2" MinimumHeightRequest="40"/>
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="Público alvo:" FontSize="12" TextColor="#40506A"/>
                                        <Label Text="{Binding PublicoAlvo}" FontSize="12" TextColor="#40506A" MaxLines="2"/>
                                    </VerticalStackLayout>
                                    <Grid ColumnDefinitions="*,12,*" Margin="0,6,0,0">
                                        <Button Text="Entrar" Clicked="AbrirTriagem" Style="{StaticResource PrimaryButton}" HeightRequest="40" FontSize="12" Padding="4,0"/>
                                        <Button Grid.Column="2" Text="Ver histórico" Clicked="AbrirHistorico" Style="{StaticResource OutlineButton}" HeightRequest="40" FontSize="11" Padding="4,0"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding ModoEdicao}">
                                        <Label Text="Exibir na home" VerticalOptions="Center" TextColor="#374151"/>
                                        <Switch Grid.Column="1" IsToggled="{Binding VisivelNaHome, Mode=TwoWay}" OnColor="#009B72"/>
                                        <Button Grid.Column="2" Text="✎" Clicked="EditarTriagem" BackgroundColor="#E6F6F1" CornerRadius="8" WidthRequest="40" HeightRequest="40" IsVisible="{Binding MinhaAutoria}" SemanticProperties.Description="Editar triagem e sua imagem"/>
                                        <Button Grid.Column="3" Text="🗑" Clicked="ExcluirTriagem" BackgroundColor="#FEE2E2" TextColor="#EF4444" CornerRadius="8" WidthRequest="40" HeightRequest="40" IsVisible="{Binding MinhaAutoria}" SemanticProperties.Description="Excluir triagem"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Button x:Name="BotaoSalvarHomeMobile"
                            Text="Salvar configuração da home"
                            Clicked="SalvarConfiguracaoHome"
                            IsVisible="False"
                            Margin="0,20,0,22"
                            Style="{StaticResource PrimaryButton}"/>
                </CollectionView.Footer>
            </CollectionView>

            <Grid Grid.Row="1" BackgroundColor="White"
                  HorizontalOptions="Fill" VerticalOptions="End"
                  HeightRequest="68" RowDefinitions="1,*">
                <BoxView Color="#EEF1F4" HeightRequest="1"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="0" Padding="4,6,4,8">
                    <Grid Grid.Column="0" RowDefinitions="24,Auto" RowSpacing="4"
                          Padding="0,2" HorizontalOptions="Fill"
                          SemanticProperties.Description="Início">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TocarInicio"/>
                        </Grid.GestureRecognizers>
                        <Image Source="nav_home.png" WidthRequest="22" HeightRequest="22"
                               HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"/>
                        <Label Grid.Row="1" Text="Início" FontSize="9"
                               TextColor="#009B72" HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" LineBreakMode="NoWrap"
                               MaxLines="1" InputTransparent="True"/>
                    </Grid>
                    <Grid Grid.Column="1" RowDefinitions="24,Auto" RowSpacing="4"
                          Padding="0,2" HorizontalOptions="Fill"
                          SemanticProperties.Description="Créditos">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="IrCreditos"/>
                        </Grid.GestureRecognizers>
                        <Image Source="nav_credits.png" WidthRequest="22" HeightRequest="22"
                               HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"/>
                        <Label Grid.Row="1" Text="Créditos" FontSize="9"
                               TextColor="#40506A" HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" LineBreakMode="NoWrap"
                               MaxLines="1" InputTransparent="True"/>
                    </Grid>
                    <Grid Grid.Column="2" RowDefinitions="24,Auto" RowSpacing="4"
                          Padding="0,2" HorizontalOptions="Fill"
                          SemanticProperties.Description="Contato">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="IrContato"/>
                        </Grid.GestureRecognizers>
                        <Image Source="nav_contact.png" WidthRequest="22" HeightRequest="22"
                               HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"/>
                        <Label Grid.Row="1" Text="Contato" FontSize="9"
                               TextColor="#40506A" HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" LineBreakMode="NoWrap"
                               MaxLines="1" InputTransparent="True"/>
                    </Grid>
                    <Grid Grid.Column="3" RowDefinitions="24,Auto" RowSpacing="4"
                          Padding="0,2" HorizontalOptions="Fill"
                          SemanticProperties.Description="Sobre o projeto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="IrSobre"/>
                        </Grid.GestureRecognizers>
                        <Image Source="nav_about.png" WidthRequest="22" HeightRequest="22"
                               HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"/>
                        <Label Grid.Row="1" Text="Sobre o projeto" FontSize="9"
                               TextColor="#40506A" HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" LineBreakMode="NoWrap"
                               MaxLines="1" InputTransparent="True"/>
                    </Grid>
                    <Grid Grid.Column="4" RowDefinitions="24,Auto" RowSpacing="4"
                          Padding="0,2" HorizontalOptions="Fill"
                          SemanticProperties.Description="Criar triagem">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="IrCriarTriagem"/>
                        </Grid.GestureRecognizers>
                        <Image Source="nav_create.png" WidthRequest="22" HeightRequest="22"
                               HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"/>
                        <Label Grid.Row="1" Text="Criar triagem" FontSize="9"
                               TextColor="#40506A" HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" LineBreakMode="NoWrap"
                               MaxLines="1" InputTransparent="True"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
