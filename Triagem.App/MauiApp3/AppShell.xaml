<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="MauiApp3.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp3"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    Shell.BackgroundColor="#FFFFFF"
    Shell.ForegroundColor="#009B72"
    Shell.TitleColor="#07142E"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Início"
        ContentTemplate="{DataTemplate local:EscolhaModoPage}"
        Route="EscolhaModoPage" />

</Shell>
