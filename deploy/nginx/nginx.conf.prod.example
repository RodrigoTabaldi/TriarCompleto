# Exemplo de referência para produção com TLS. NÃO é usado automaticamente pelo
# docker-compose.yml (que usa nginx.conf, em HTTP puro, adequado só para rede local/
# desenvolvimento). Para expor a API publicamente, copie este arquivo para
# nginx.conf, gere um certificado (ex.: Let's Encrypt/certbot) e ajuste os caminhos
# abaixo antes de subir.
#
# Passos típicos com certbot (fora do container, no host, ou via um container
# certbot dedicado):
#   certbot certonly --standalone -d api.seu-dominio.com
#   -> gera /etc/letsencrypt/live/api.seu-dominio.com/fullchain.pem e privkey.pem
#   Monte esse diretório como volume read-only no serviço nginx do docker-compose.

worker_processes auto;

events {
    worker_connections 1024;
}

http {
    upstream triar_api {
        least_conn;
        server api1:8080 max_fails=3 fail_timeout=10s;
        server api2:8080 max_fails=3 fail_timeout=10s;
        keepalive 32;
    }

    limit_req_zone $binary_remote_addr zone=borda:10m rate=30r/s;

    # ---------- HTTP: só redireciona para HTTPS ----------
    server {
        listen 80;
        server_name api.seu-dominio.com;
        return 301 https://$host$request_uri;
    }

    # ---------- HTTPS ----------
    server {
        listen 443 ssl;
        http2 on;
        server_name api.seu-dominio.com;

        ssl_certificate     /etc/letsencrypt/live/api.seu-dominio.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/api.seu-dominio.com/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

        location / {
            limit_req zone=borda burst=60 nodelay;

            proxy_pass http://triar_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_connect_timeout 5s;
            proxy_read_timeout 30s;

            proxy_next_upstream error timeout http_502 http_503 http_504;
        }

        location /health {
            proxy_pass http://triar_api/health;
        }
    }
}
